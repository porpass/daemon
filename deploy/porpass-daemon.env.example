# PORPASS processing daemon — PRODUCTION environment file (template).
#
# Copy to /etc/porpass-daemon/porpass-daemon.env on the production host, fill in
# real values, and `chmod 600` it (it holds the DB password). The systemd unit
# reads it via EnvironmentFile= — values are taken LITERALLY, so a '$' in the
# password needs no escaping. There is NO `.env` in a production checkout.
#
# TWO HARD ISOLATION RULES (prod and dev must never share state):
#   1. DB_DATABASE is the PRODUCTION database (porpass), never a dev DB
#      (server dev: porpass-dev, local dev: porpass_dev).
#   2. PORPASS_STORAGE_PATH is the PRODUCTION storage mount, never a dev path.
# GRaSP in the prod conda env (porpass-proc) is PINNED to the released tag; see
# deploy/README.md step 4. Dev, by contrast, runs an editable GRaSP.

# ── Database (remote MariaDB / MySQL) ──────────────────────────────────────
DB_HOST=<db-host>
DB_PORT=3306
DB_DATABASE=porpass
DB_USERNAME=porpass_proc
DB_PASSWORD=<password>

# ── Shared storage ─────────────────────────────────────────────────────────
# Absolute path to the production porpass-storage mount, shared with porpass-web.
PORPASS_STORAGE_PATH=/mnt/porpass-storage

# ── GRaSP ──────────────────────────────────────────────────────────────────
# Bare name resolves on PATH inside the porpass-proc conda env (where GRaSP is
# pinned to the released tag). Used for `grasp run`; schema generation is
# in-process from the same importable GRaSP.
GRASP_BIN=grasp

# ── Daemon behaviour ───────────────────────────────────────────────────────
DAEMON_POLL_INTERVAL=5
DAEMON_HEARTBEAT_INTERVAL=30
DAEMON_REAPER_STALE_SECONDS=300
DAEMON_CANCEL_POLL_INTERVAL=5
# Blank -> {hostname}-{pid}. Set a `prod-` prefix if you want it explicit.
DAEMON_WORKER_ID=
DAEMON_PUBLISH_SCHEMAS_ON_START=1
