# PORPASS processing daemon (porpass-proc) configuration.
# Copy this file to `.env` and fill in real values. The .env file is gitignored
# and must never be committed.
#
# Variable names for the database and storage mount are shared verbatim with the
# porpass web app and its gis/ service so a single set of credentials works
# across the whole system.

# ── Database (MariaDB / MySQL) ─────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=porpass_dev
DB_USERNAME=porpass
DB_PASSWORD=change-me

# ── Shared storage ─────────────────────────────────────────────────────────
# Absolute path to the porpass-storage mount, shared with porpass-web. The
# daemon reads per-job config from
#   {PORPASS_STORAGE_PATH}/processing/{user_id}/{job_id}/config.json
# and writes job.toml, run.log, manifest.json + result products alongside it.
# Schema artifacts are published to {PORPASS_STORAGE_PATH}/schemas/.
PORPASS_STORAGE_PATH=/Users/Shared/porpass-storage

# ── GRaSP ──────────────────────────────────────────────────────────────────
# The GRaSP executable invoked as `{GRASP_BIN} run <job.toml> -v`. Override to
# point at a specific install or a fake binary during testing.
GRASP_BIN=grasp

# ── Daemon behaviour ───────────────────────────────────────────────────────
# Seconds between polls for queued jobs when idle.
DAEMON_POLL_INTERVAL=5
# Seconds between heartbeat (claimed_at) bumps while a job runs.
DAEMON_HEARTBEAT_INTERVAL=30
# A 'running' job whose claimed_at is older than this many seconds is considered
# abandoned (crashed worker) and is requeued by the reaper. Recommend 5-10x the
# heartbeat interval.
DAEMON_REAPER_STALE_SECONDS=300
# Seconds between checks of a running job's cancel_requested flag. Lower = a
# cancel takes effect faster, at the cost of slightly more DB queries.
DAEMON_CANCEL_POLL_INTERVAL=5
# Worker identity written to processing_jobs.claimed_by. Leave blank to derive
# {hostname}-{pid} automatically.
DAEMON_WORKER_ID=
# Publish GRaSP schema artifacts to {PORPASS_STORAGE_PATH}/schemas/ on startup.
DAEMON_PUBLISH_SCHEMAS_ON_START=1
